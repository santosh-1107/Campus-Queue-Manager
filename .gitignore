# ==============================================================================
# Git Ignore Configuration - Campus Queue Manager
# ==============================================================================

# Environment variables (CRITICAL: Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
*.env
!.env.example
!**/.env.example

# Dependency directories
node_modules/
*/node_modules/
**/node_modules/
package-lock.json.backup

# Build outputs
dist/
dist-ssr/
build/
out/
*/dist/
*/build/
**/dist/

# Debug and runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and OS metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing and coverage
coverage/
*.lcov
.nyc_output

# Temporary and cache files
.cache/
.parcel-cache/
.eslintcache
tmp/
temp/
